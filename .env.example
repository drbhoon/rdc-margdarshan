# Configure these in Railway (or a private local .env file). Never commit real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
APP_URL="https://rdc-margdarshan-production.up.railway.app"

# A random secret of at least 32 bytes, encoded as base64.
SESSION_SECRET=""

# Google OAuth web client. Register this exact authorized redirect URI:
# https://rdc-margdarshan-production.up.railway.app/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated corporate email addresses with administrator access.
ADMIN_EMAILS="ksbhoon@rdc.in,puja.singh@rdc.in"

# Keep the one-click sample personas available for proof-of-concept reviews.
DEMO_MODE="true"

# Optional AI coaching assistant. The app gives clearly labelled guided prompts
# when this is absent or unavailable.
GEMINI_API_KEY=""

# SMTP email delivery (supports both SMTP_PASSWORD/SMTP_FROM and SMTP_PASS/EMAIL_FROM)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Margdarshan Mentoring <noreply@rdc.in>"
